# MongoDB Atlas Connection String
# Replace with your actual connection string when running locally
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority&appName=AbhiShiksha

# Database name
DATABASE_NAME=abhishiksha

# Firebase Admin Service Account JSON File Path (Absolute or relative to backend directory)
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/your/firebase-service-account.json
